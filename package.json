{
  "name": "tev-ui",
  "version": "0.2.0",
  "description": "Tevvoice shared UI — shadcn primitives and brand components, themeable via CSS variables.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matevosyanmko/tev-ui.git"
  },
  "homepage": "https://github.com/matevosyanmko/tev-ui#readme",
  "bugs": {
    "url": "https://github.com/matevosyanmko/tev-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./theme.css": "./dist/theme.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json",
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./primitives/*": {
      "types": "./dist/ui/primitives/*/index.d.ts",
      "default": "./dist/ui/primitives/*/index.js"
    },
    "./brand/*": {
      "types": "./dist/ui/brand/*/index.d.ts",
      "default": "./dist/ui/brand/*/index.js"
    },
    "./layout/*": {
      "types": "./dist/ui/layout/*/index.d.ts",
      "default": "./dist/ui/layout/*/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch & node scripts/watch-css.mjs & wait",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "verify:package": "scripts/verify-tarball.sh",
    "chromatic": "chromatic --build-script-name build:storybook",
    "prepack": "npm run build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "dayjs": "^1.11.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-day-picker": "^9.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-hook-form": "^7.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "dayjs": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "chromatic": "^18.7.1",
    "dayjs": "^1.11.23",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.2",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.2.1",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.1"
  }
}
