{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,

    // vite.config.ts and .storybook/ run in Node.
    "types": ["node"],

    "paths": {
      // Only so `npx shadcn add` can resolve its own generated imports.
      // There is deliberately no "tev-ui/*" mapping: everything inside
      // src/ imports relatively, and a mapping here would not match the
      // published exports map anyway (which carries a `ui/` segment).
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", ".storybook", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "storybook-static"]
}
